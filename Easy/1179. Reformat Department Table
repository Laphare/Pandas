import pandas as pd

def reformat_table(department: pd.DataFrame) -> pd.DataFrame:
    res = department.pivot(index='id', columns='month', values='revenue')
    months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    res = res.reindex(columns=months)
    res.columns = [f"{col}_Revenue" for col in res.columns]
    return res.reset_index()

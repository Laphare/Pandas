import pandas as pd

def most_friends(request_accepted: pd.DataFrame) -> pd.DataFrame:
   all_friends = pd.concat([request_accepted["requester_id"],request_accepted["accepter_id"]]).rename("id")
   df = all_friends.value_counts().reset_index(name="num")
   df["rn"] = df["num"].rank(ascending = False, method = "dense")

   return df.query("rn == 1")[["id","num"]]

import pandas as pd

def sales_person(sales_person: pd.DataFrame, company: pd.DataFrame, orders: pd.DataFrame) -> pd.DataFrame:
    df_company = company.loc[company["name"] == "RED","com_id"]
    df_has_order = orders.loc[orders["com_id"].isin(df_company),"sales_id"].drop_duplicates()
    df = sales_person.loc[(~sales_person["sales_id"].isin(df_has_order)),["name"]]
    return df

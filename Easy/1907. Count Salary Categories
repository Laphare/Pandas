import pandas as pd
import numpy as np
def count_salary_categories(accounts: pd.DataFrame) -> pd.DataFrame:
    accounts["category"] = np.select([accounts["income"]<20000,(20000<=accounts["income"]) & (accounts["income"]<=50000),accounts["income"]>50000],["Low Salary","Average Salary","High Salary"])
    return accounts.groupby("category")["account_id"].size().reindex(["Low Salary","Average Salary","High Salary"],fill_value = 0).reset_index(name="accounts_count")

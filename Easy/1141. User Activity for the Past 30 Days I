import pandas as pd

def user_activity(activity: pd.DataFrame) -> pd.DataFrame:
    start_time = pd.to_datetime("2019-07-27") - pd.Timedelta(days=29)
    activity = activity.query("@start_time <= activity_date <= '2019-07-27'")
    return activity.groupby("activity_date", as_index=False)[["user_id"]].nunique().rename(columns={"activity_date": "day", "user_id": "active_users"})

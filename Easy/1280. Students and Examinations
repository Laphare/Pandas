import pandas as pd

def students_and_examinations(students: pd.DataFrame, subjects: pd.DataFrame, examinations: pd.DataFrame) -> pd.DataFrame:
    df = examinations.groupby(["student_id","subject_name"],as_index=False).size().rename(columns = {"size":"attended_exams"})
    df1 = students.merge(subjects,how="cross")
    df2 = df1.merge(df, on = ["student_id","subject_name"],how ="left").fillna(0)
    
    return df2.sort_values(["student_id","subject_name"])

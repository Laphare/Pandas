import pandas as pd

def top_travellers(users: pd.DataFrame, rides: pd.DataFrame) -> pd.DataFrame:
    u = rides.groupby("user_id")["distance"].sum().reset_index(name = "travelled_distance")
    result = users.merge(u,left_on="id",right_on = "user_id",how="left")
    return result[["name","travelled_distance"]].fillna(0).sort_values(["travelled_distance","name"],ascending=[False,True])

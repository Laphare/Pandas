import pandas as pd

def gameplay_analysis(activity: pd.DataFrame) -> pd.DataFrame:
    first_login = (
        activity.groupby("player_id")["event_date"]
        .min()
        .reset_index()
    )

    first_login["next_day"] = (
        first_login["event_date"] + pd.Timedelta(days=1)
    )

    df = first_login.merge(
        activity,
        left_on=["player_id", "next_day"],
        right_on=["player_id", "event_date"]
    )

    fraction = round(
        df["player_id"].nunique() /
        activity["player_id"].nunique(),
        2
    )

    return pd.DataFrame({"fraction": [fraction]})

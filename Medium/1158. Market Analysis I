import pandas as pd

def market_analysis(users: pd.DataFrame, orders: pd.DataFrame, items: pd.DataFrame) -> pd.DataFrame:
    orders = orders.query("order_date.dt.year == 2019 ")
    orders["orders_in_2019"] = orders.groupby("buyer_id")["buyer_id"].transform("count")
    orders = orders.drop_duplicates("buyer_id")
    df = users.merge(orders, left_on = "user_id",right_on="buyer_id",how="left").fillna(0)
    return df[["user_id","join_date","orders_in_2019"]].rename(columns={"user_id":"buyer_id"})


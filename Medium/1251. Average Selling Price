import pandas as pd

def average_selling_price(prices: pd.DataFrame, units_sold: pd.DataFrame) -> pd.DataFrame:
    df = prices.merge(units_sold, on="product_id",how="left")
    df = df.query("start_date <= purchase_date <= end_date")
    df["amount"] = df["price"] * df["units"]
    df = df.groupby("product_id",as_index = False).agg(total_amount = ("amount","sum"),total_unit=("units","sum"))
    df["average_price"]=(df["total_amount"]/df["total_unit"]).round(2)
    return prices[["product_id"]].merge(df[["product_id", "average_price"]],on="product_id",how="left").fillna(0).drop_duplicates("product_id")

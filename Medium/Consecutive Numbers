import pandas as pd

def consecutive_numbers(logs: pd.DataFrame) -> pd.DataFrame:
    logs["prev_num_1"]=logs["num"].shift(1)
    logs["prev_num_2"]=logs["num"].shift(2)
    return logs[(logs["num"]==logs["prev_num_1"]) & (logs["prev_num_1"]==logs["prev_num_2"])][["num"]].rename(columns = {"num":"ConsecutiveNums"})

import pandas as pd

def confirmation_rate(signups: pd.DataFrame, confirmations: pd.DataFrame) -> pd.DataFrame:
    df1 = confirmations.groupby("user_id")["action"].count().reindex(signups["user_id"],fill_value=0).reset_index(name="count")
    df2 = confirmations[confirmations["action"] == "confirmed"].groupby("user_id")["action"].count().reindex(signups["user_id"],fill_value=0).reset_index(name="tcount")
    df = df1.merge(df2,on="user_id")
    df["confirmation_rate"] = (df["tcount"]/df["count"]).round(2).fillna(0)
    return df[["user_id","confirmation_rate"]]
